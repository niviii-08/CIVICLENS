# CivicLens TN - Environment Configuration Example
# All values shown below are placeholders or safe defaults. Never commit real production secrets.

# Application Info
APP_NAME="CivicLens TN"
ENV="development"
DEBUG=False

# Cryptographic and API Key Secrets (Placeholders - must be overridden in production)
SECRET_KEY="replace-with-a-secure-random-secret-key-for-production"
REVIEWER_API_KEY="replace-with-a-secure-reviewer-api-key-for-production"

# API & Gateway Configuration
API_HOST="0.0.0.0"
API_PORT=5000
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
MAX_CONTENT_LENGTH=16777216
INTERNAL_API_URL="http://127.0.0.1:5000"

# Database Configuration
DATABASE_URL="sqlite:///data/processed/civiclens.db"

# Directory Configuration
DATA_DIR="data"
RAW_DATA_DIR="data/raw"
PROCESSED_DATA_DIR="data/processed"
MODEL_DIR="ml/models"

# Logging Configuration
LOG_LEVEL="INFO"

# External Data Source Credentials (Optional - Scraper Integration Placeholders)
X_CONSUMER_KEY="placeholder-x-consumer-key"
X_CONSUMER_SECRET="placeholder-x-consumer-secret"
X_BEARER_TOKEN="placeholder-x-bearer-token"
YOUTUBE_API_KEY="placeholder-youtube-api-key"
